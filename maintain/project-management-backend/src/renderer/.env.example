# =============================================================
# 环境变量模板（渲染进程 / Web 端）
# -------------------------------------------------------------
# 规则：只有以 VITE_ 开头的变量才会暴露给渲染进程，
#       可在任意组件/模块中通过 import.meta.env.VITE_XXX 读取。
# 加载：npm run dev 自动加载本目录 .env.development；
#       打包构建（npm run build）自动加载本目录 .env.production。
# 覆盖：本地个人配置请复制本文件为 .env.local，不要改下面两文件。
# 说明：env 目录由 electron.vite.config.ts renderer.envDir 指定，
#       仅渲染进程会加载这些变量。
# =============================================================

# 应用标题（示例，已用于 index.html 的 <title>）
VITE_APP_TITLE=项目发布管理系统

# 后端 API 基础地址（示例，联调时改成真实后端地址，如 http://192.168.1.10:8080）
VITE_API_BASE_URL=
